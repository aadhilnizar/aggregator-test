# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://orderhub:orderhub@localhost:5432/orderhub?schema=public"

# ─── HTTP ───────────────────────────────────────────────────
PORT=4000
# Comma-separated allow-list for CORS (the Vite dev server ports).
WEB_ORIGIN="http://localhost:5173,http://localhost:5174"

# ─── Auth (CHANGE THESE) ────────────────────────────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

